{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "ui_kits/marketing/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Burford|Burford Outline|Burford Line|Burford Rustic|Caligor|Caligor Edge|Caligor Stamp|Caligor Sans|Caligor Sans Edge|Caligor Sans Stamp|Esther|Esther Exhaust|Outfit))/i]",
        "message": "Font not provided by the design system. Available: Burford, Burford Outline, Burford Line, Burford Rustic, Caligor, Caligor Edge, Caligor Stamp, Caligor Sans, Caligor Sans Edge, Caligor Sans Stamp, Esther, Esther Exhaust, Outfit."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
